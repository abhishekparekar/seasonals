# Ensure proper MIME types for JavaScript ES modules, CSS, and web fonts
<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. If file or folder exists, serve directly without any rewrite
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Never rewrite missing static assets to index.html (prevents MIME type error)
  RewriteCond %{REQUEST_URI} \.(js|mjs|css|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|eot)$ [NC]
  RewriteRule ^ - [R=404,L]

  # 3. Handle /admin route directly
  RewriteRule ^admin/?$ /index.html [L,QSA]

  # 4. Standard SPA rewrite for all client-side navigation
  RewriteRule . /index.html [L]
</IfModule>
